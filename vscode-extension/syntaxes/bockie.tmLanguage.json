{
  "scopeName": "source.bockie",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#comments" },
    { "include": "#functions" },
    { "include": "#classes" },
    { "include": "#operators" },
    { "include": "#booleans" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        { "name": "keyword.control.bockie", "match": "\\b(if|elif|else|while|until|for|in|break|continue|pass|return|try|except|finally|raise|with|as|import|from|global|nonlocal|del|assert|is|not|and|or|unless|match|case|when|default|repeat|times)\\b" },
        { "name": "keyword.other.bockie", "match": "\\b(def|fn|class|lambda)\\b" },
        { "name": "keyword.operator.bockie", "match": "(\\|>|\\?\\?|\\.\\.\\.|\\*\\*|:=|->)" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bockie",
          "begin": "\"", "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.bockie", "match": "\\\\." },
            { "name": "string.interpolation.bockie", "match": "\\{[^}]+\\}" }
          ]
        },
        {
          "name": "string.quoted.single.bockie",
          "begin": "'", "end": "'",
          "patterns": [
            { "name": "constant.character.escape.bockie", "match": "\\\\." },
            { "name": "string.interpolation.bockie", "match": "\\{[^}]+\\}" }
          ]
        }
      ]
    },
    "numbers": { "patterns": [{ "name": "constant.numeric.bockie", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }] },
    "comments": { "patterns": [{ "name": "comment.line.number-sign.bockie", "match": "#.*$" }] },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.bockie", "match": "\\b(def|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b", "captures": { "1": { "name": "keyword.other.bockie" }, "2": { "name": "entity.name.function.bockie" } } },
        { "name": "support.function.bockie", "match": "\\b(print|input|len|range|list|dict|tuple|str|int|float|bool|type|isinstance|enumerate|zip|sorted|reversed|map|filter|reduce|abs|min|max|sum|round|floor|ceil|sqrt|pow|sin|cos|tan|atan2|log|exp|pi|format|hex|bin|oct|chr|ord|random|randint|choice|shuffle|time|now|sleep|fs_read|fs_write|fs_exists|fs_mkdir|fs_list|os_name|os_arch|os_home|os_env|os_cpu_count|regex_match|regex_find|regex_replace|regex_split|date_year|date_month|date_format|shell|shell_silent|md5|sha1|sha256|sha512|base64_encode|base64_decode|url_encode|url_decode|uuid|hmac_sha256|json_dumps|json_loads|http_get|http_post|exit|argv)\\b" }
      ]
    },
    "classes": {
      "patterns": [
        { "name": "entity.name.type.class.bockie", "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b", "captures": { "1": { "name": "keyword.other.bockie" }, "2": { "name": "entity.name.type.bockie" } } }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arithmetic.bockie", "match": "(\\+|\\-|\\*|/|%|\\*\\*)" },
        { "name": "keyword.operator.comparison.bockie", "match": "(==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.assignment.bockie", "match": "(=|\\+=|\\-=|\\*=|/=|%=)" }
      ]
    },
    "booleans": {
      "patterns": [
        { "name": "constant.language.boolean.bockie", "match": "\\b(True|False)\\b" },
        { "name": "constant.language.null.bockie", "match": "\\b(None)\\b" }
      ]
    }
  }
}
